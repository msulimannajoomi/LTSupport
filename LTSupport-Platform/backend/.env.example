# Copy this to .env and fill in real values. .env itself is gitignored and
# dockerignored -- it's never committed and never baked into the image; pass it to the
# container at run time instead (see the docker run command in the Dockerfile comment).
LTSUPPORT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
LTSUPPORT_MONGODB_DB=ltsupport
LTSUPPORT_API_PORT=8000
LTSUPPORT_RELAY_PORT=7000
# Groq API key for the overlay's speech-to-text button (console.groq.com/keys) -- kept
# server-side only, never baked into the desktop client (see /api/speech/transcribe).
GROQ_API_KEY=gsk_<your-groq-key>
# Paddle: prepaid top-ups. Use https://sandbox-api.paddle.com while testing,
# https://api.paddle.com once you're ready to take real payments -- always double
# check which environment a key/price actually belongs to (call GET /prices/<id>
# against both hosts) rather than trusting a label, sandbox and live keys/IDs are
# never interchangeable.
PADDLE_API_BASE=https://sandbox-api.paddle.com
PADDLE_API_KEY=pdl_sdbx_apikey_<your-key>
PADDLE_PRICE_ID=pri_<your-per-hour-price-id>
# From Paddle dashboard: Developer Tools -> Notifications -> your destination's
# Secret Key. Required -- without it /api/webhooks/paddle can't tell a real Paddle
# payment notification apart from anyone who just POSTs to that URL.
PADDLE_WEBHOOK_SECRET=
