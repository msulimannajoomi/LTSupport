# Copy this to .env and fill in real values. .env itself is gitignored and
# dockerignored -- it's never committed and never baked into the image; pass it to the
# container at run time instead (see the docker run command in the Dockerfile comment).
LTSUPPORT_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
LTSUPPORT_MONGODB_DB=ltsupport
LTSUPPORT_API_PORT=8000
LTSUPPORT_RELAY_PORT=7000
# Groq API key for the overlay's speech-to-text button (console.groq.com/keys) -- kept
# server-side only, never baked into the desktop client (see /api/speech/transcribe).
GROQ_API_KEY=gsk_<your-groq-key>
# Stripe: prepaid top-ups via a hosted Checkout Session (see create_checkout in
# app.py). sk_test_... while testing, sk_live_... once ready for real payments --
# unlike Paddle, Stripe's key prefix itself is an authoritative test/live split, so
# there's no separate "verify which environment this belongs to" step needed.
STRIPE_API_KEY=sk_test_<your-key>
# The per-hour price itself (STRIPE_UNIT_AMOUNT_CENTS) is set directly in config.py,
# not here -- see the comment there if it ever needs to change.
# From the Stripe dashboard: Developers -> Webhooks -> your endpoint's Signing
# secret. Required -- without it /api/webhooks/stripe can't tell a real Stripe
# payment notification apart from anyone who just POSTs to that URL.
STRIPE_WEBHOOK_SECRET=whsec_<your-secret>
# Interim "request an upgrade by email" flow (see /api/billing/request-upgrade) --
# temporary, used only while the live Stripe account above is still completing its
# own activation. A Gmail "App Password" (Google Account -> Security -> App
# Passwords, requires 2FA), not the account's normal login password.
SMTP_USERNAME=<your-gmail-address>@gmail.com
SMTP_PASSWORD=<your-16-char-app-password>
